<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <group name="group1" position="inside">
                <field name="is_advance" readonly="state != 'draft'" />
                <field
                    name="advance_residual"
                    invisible="not is_advance or state in ('draft', 'canceled', 'rejected')"
                />
                <field name="company_currency_id" invisible="1" />
            </group>
        </field>
    </record>

    <record id="view_account_payment_search" model="ir.ui.view">
        <field name="name">account.payment.search.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search" />
        <field name="arch" type="xml">
            <filter name="reconciled" position="after">
                <separator />
                <filter
                    name="advances"
                    string="Advances"
                    domain="[('is_advance', '=', True)]"
                />
                <filter
                    name="unapplied"
                    string="Unapplied"
                    domain="[('is_advance', '=', True), ('advance_residual', '>', 0)]"
                />
            </filter>
        </field>
    </record>

    <record id="view_account_payment_advance_tree" model="ir.ui.view">
        <field name="name">account.payment.advance.tree</field>
        <field name="model">account.payment</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <list
                decoration-muted="advance_residual == 0 or state in ('draft', 'canceled', 'rejected')"
            >
                <field name="date" />
                <field name="name" />
                <field name="partner_id" />
                <field name="journal_id" />
                <field name="currency_id" column_invisible="True" />
                <field name="company_currency_id" column_invisible="True" />
                <field name="amount" sum="Total" />
                <field name="advance_residual" sum="Unapplied" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state in ('in_process', 'paid')"
                />
            </list>
        </field>
    </record>

    <record id="action_customer_advances" model="ir.actions.act_window">
        <field name="name">Customer Advances</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_payment_advance_tree" />
        <field
            name="domain"
        >[('is_advance', '=', True), ('partner_type', '=', 'customer')]</field>
        <field name="context">{
            'default_is_advance': True,
            'default_payment_type': 'inbound',
            'default_partner_type': 'customer',
            'default_move_journal_types': ('bank', 'cash'),
            'search_default_unapplied': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a customer advance</p>
            <p>
                A deposit received before the invoice. It stays on the customer
                advances account until you apply it to an invoice.
            </p>
        </field>
    </record>

    <record id="action_vendor_prepayments" model="ir.actions.act_window">
        <field name="name">Vendor Prepayments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_payment_advance_tree" />
        <field
            name="domain"
        >[('is_advance', '=', True), ('partner_type', '=', 'supplier')]</field>
        <field name="context">{
            'default_is_advance': True,
            'default_payment_type': 'outbound',
            'default_partner_type': 'supplier',
            'default_move_journal_types': ('bank', 'cash'),
            'search_default_unapplied': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a vendor prepayment</p>
            <p>
                Money paid before the bill. It stays on the vendor prepayments
                account until you apply it to a bill.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_customer_advances"
        name="Advances"
        parent="account.menu_finance_receivables"
        action="action_customer_advances"
        sequence="16"
    />
    <menuitem
        id="menu_vendor_prepayments"
        name="Prepayments"
        parent="account.menu_finance_payables"
        action="action_vendor_prepayments"
        sequence="21"
    />
</odoo>
