<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_advance_apply_view_form" model="ir.ui.view">
        <field name="name">account.advance.apply.form</field>
        <field name="model">account.advance.apply</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="move_id" />
                    <field name="available_payment_ids" invisible="1" />
                    <field name="currency_id" invisible="1" />
                    <field name="payment_id" options="{'no_create': True}" />
                    <field name="advance_residual" invisible="not payment_id" />
                    <field name="amount" />
                </group>
                <footer>
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
