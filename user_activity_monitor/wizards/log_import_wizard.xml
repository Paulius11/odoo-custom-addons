<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_log_import_wizard_form" model="ir.ui.view">
        <field name="name">user.activity.log.import.wizard.form</field>
        <field name="model">user.activity.log.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Sessions from Log File">
                <field name="state" invisible="1"/>
                <group>
                    <field name="log_path" readonly="state == 'done'"/>
                </group>
                <group invisible="state == 'draft'">
                    <field name="import_count" readonly="1"/>
                    <field name="skipped_count" readonly="1"/>
                    <field name="summary" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_import"
                            string="Import"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_log_import_wizard" model="ir.actions.act_window">
        <field name="name">Import from Log File</field>
        <field name="res_model">user.activity.log.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
