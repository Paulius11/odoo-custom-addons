<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_expire_sessions" model="ir.cron">
        <field name="name">User Activity: Expire Stale Sessions</field>
        <field name="model_id" ref="model_user_session_log"/>
        <field name="state">code</field>
        <field name="code">model._mark_expired_sessions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
