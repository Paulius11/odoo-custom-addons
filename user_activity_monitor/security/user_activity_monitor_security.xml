<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_user_session_log_own" model="ir.rule">
        <field name="name">User Session Log: Own Records Only</field>
        <field name="model_id" ref="model_user_session_log"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rules of a user's groups are OR-ed: without this, administrators (also internal users)
         would only see their own sessions. -->
    <record id="rule_user_session_log_admin_all" model="ir.rule">
        <field name="name">User Session Log: Administrators See All</field>
        <field name="model_id" ref="model_user_session_log"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
