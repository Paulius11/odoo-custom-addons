<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Users Form View to Add Copy Permissions Button -->
    <record id="view_users_form_copy_permissions" model="ir.ui.view">
        <field name="name">res.users.form.copy.permissions</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_copy_permissions_wizard"
                        type="object"
                        string="Copy Permissions"
                        class="btn-primary"
                        icon="fa-copy"
                        groups="base.group_system"
                        help="Copy this user's permissions to another user"/>
            </xpath>
        </field>
    </record>

</odoo>