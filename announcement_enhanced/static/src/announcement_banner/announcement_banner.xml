<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="announcement_enhanced.AnnouncementBanner">
        <div t-if="shouldShow" class="ae_announcement_banner" t-on-click="openAnnouncement">
            <div class="ae_banner_content">
                <i class="fa fa-bullhorn me-2"/>
                <strong t-esc="currentAnnouncement.name"/>
            </div>
            <div class="ae_banner_actions">
                <button class="btn btn-sm ae_banner_btn" t-on-click="openAnnouncement">
                    Read more
                </button>
            </div>
        </div>
    </t>

    <t t-name="announcement_enhanced.NavBar"
       t-inherit="web.NavBar"
       t-inherit-mode="extension">
        <xpath expr="//nav" position="after">
            <AnnouncementBanner/>
        </xpath>
    </t>

</templates>
