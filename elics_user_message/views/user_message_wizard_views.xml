<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_user_message_wizard_form" model="ir.ui.view">
        <field name="name">elics.user.message.wizard.form</field>
        <field name="model">elics.user.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Message to User">
                <group>
                    <field name="user_id"/>
                    <field name="message" widget="html" colspan="2"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_user_message_wizard" model="ir.actions.act_window">
        <field name="name">Send Message to User</field>
        <field name="res_model">elics.user.message.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
