<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web_listview_column_presets.SavePresetDialog">
        <Dialog title="dialogTitle" size="'md'">
            <div class="o_column_preset_save_dialog">
                <div class="mb-3">
                    <label for="preset_name" class="form-label" t-esc="presetNameLabel"/>
                    <input
                        id="preset_name"
                        class="form-control"
                        type="text"
                        t-att-value="state.name"
                        t-on-input="onNameChange"
                        t-att-placeholder="presetPlaceholder"
                        autofocus="autofocus"
                    />
                </div>

                <div t-if="canShare" class="mb-3 form-check">
                    <input
                        id="preset_shared"
                        class="form-check-input"
                        type="checkbox"
                        t-att-checked="state.isShared"
                        t-on-change="onSharedChange"
                    />
                    <label class="form-check-label" for="preset_shared" t-esc="shareLabel"/>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onSave" t-att-disabled="!state.name.trim()" t-esc="saveLabel"/>
                <button class="btn btn-secondary" t-on-click="onCancel" t-esc="cancelLabel"/>
            </t>
        </Dialog>
    </t>

</templates>
