<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <!-- Form View -->
        <record id="ir_listview_column_preset_view_form" model="ir.ui.view">
            <field name="name">ir.listview.column.preset.form</field>
            <field name="model">ir.listview.column.preset</field>
            <field name="arch" type="xml">
                <form string="Column Presets">
                    <sheet>
                        <group col="4">
                            <field name="name"/>
                            <field name="user_id" string="Available for User"/>
                            <field name="model_id" string="Model"/>
                            <field name="is_shared" readonly="1"/>
                        </group>
                        <group>
                            <field name="parent_model_id"/>
                            <field name="relational_field"/>
                        </group>
                        <group>
                            <field name="column_fields" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="ir_listview_column_preset_view_tree" model="ir.ui.view">
            <field name="name">ir.listview.column.preset.tree</field>
            <field name="model">ir.listview.column.preset</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="model_id"/>
                    <field name="user_id"/>
                    <field name="is_shared" widget="boolean_toggle"/>
                    <field name="parent_model_id" optional="hide"/>
                    <field name="relational_field" optional="hide"/>
                    <field name="column_fields" groups="base.group_no_one" optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- Search View -->
        <record id="ir_listview_column_preset_view_search" model="ir.ui.view">
            <field name="name">ir.listview.column.preset.search</field>
            <field name="model">ir.listview.column.preset</field>
            <field name="arch" type="xml">
                <search string="Column Presets">
                    <field name="name" string="Preset Name"/>
                    <field name="model_id" string="Model"/>
                    <field name="user_id" string="User"/>

                    <!-- Filters -->
                    <filter string="My Presets" name="my_presets"
                            domain="[('user_id','=',uid)]"
                            help="Presets created by me"/>
                    <filter string="Shared Presets" name="shared"
                            domain="[('user_id','=',False)]"
                            help="Presets shared with all users"/>
                    <filter string="User Presets" name="user"
                            domain="[('user_id','!=',False)]"
                            help="Presets visible only for specific users"/>

                    <separator/>

                    <!-- Group By -->
                    <group expand="0" string="Group By">
                        <filter string="Model" name="group_model"
                                domain="[]"
                                context="{'group_by':'model_id'}"/>
                        <filter string="User" name="group_user"
                                domain="[]"
                                context="{'group_by':'user_id'}"/>
                        <filter string="Shared" name="group_shared"
                                domain="[]"
                                context="{'group_by':'is_shared'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_ir_listview_column_preset" model="ir.actions.act_window">
            <field name="name">List View Column Presets</field>
            <field name="res_model">ir.listview.column.preset</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_my_presets': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No column presets found
                </p>
                <p>
                    Column presets allow you to save and quickly apply custom column configurations for list views.
                    Create presets through the gear icon in any list view with optional columns.
                </p>
            </field>
        </record>

        <!-- Menu Item under Settings > Technical > User Interface -->
        <menuitem
            id="menu_ir_listview_column_preset"
            name="List View Column Presets"
            parent="base.next_id_2"
            action="action_ir_listview_column_preset"
            sequence="6"
            groups="base.group_no_one"/>
</odoo>
