<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.advance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- Default Accounts shows to accountants only; Invoicing admins need this too -->
            <block id="pay_invoice_online_setting_container" position="after">
                <block title="Advance Payments" id="advance_payments">
                    <setting
                        id="advance_payment_accounts"
                        string="Advance payments"
                        help="Customer deposits and vendor prepayments wait here until applied to an invoice or bill. Use accounts of their own, not the partners' receivable or payable."
                    >
                        <div class="content-group">
                            <div class="row mt8">
                                <label
                                    for="advance_customer_account_id"
                                    string="Customer advances"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="advance_customer_account_id" />
                            </div>
                            <div class="row mt8">
                                <label
                                    for="advance_vendor_account_id"
                                    string="Vendor prepayments"
                                    class="col-lg-5 o_light_label"
                                />
                                <field name="advance_vendor_account_id" />
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
