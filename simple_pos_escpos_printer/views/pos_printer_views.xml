<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_printer_form" model="ir.ui.view">
        <field name="name">pos.printer.form.escpos</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form" />
        <field name="arch" type="xml">
            <field name="proxy_ip" position="after">
                <field
                    name="escpos_host"
                    placeholder="e.g. 192.168.1.50"
                    invisible="printer_type != 'escpos_network'"
                    required="printer_type == 'escpos_network'"
                />
                <field
                    name="escpos_port"
                    options="{'enable_formatting': false}"
                    invisible="printer_type != 'escpos_network'"
                    required="printer_type == 'escpos_network'"
                />
                <field
                    name="escpos_paper"
                    widget="radio"
                    options="{'horizontal': true}"
                    invisible="printer_type != 'escpos_network'"
                    required="printer_type == 'escpos_network'"
                />
            </field>
            <widget name="point_of_sale_test_epos" position="after">
                <button
                    name="action_escpos_test_print"
                    type="object"
                    string="Test Print"
                    icon="fa-print"
                    class="btn-secondary"
                    invisible="printer_type != 'escpos_network'"
                />
            </widget>
        </field>
    </record>
</odoo>
