<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_log_event_list" model="ir.ui.view">
        <field name="name">log.event.list</field>
        <field name="model">log.event</field>
        <field name="arch" type="xml">
            <tree string="Log Events"
                  create="false"
                  decoration-danger="level == 'CRITICAL'"
                  decoration-warning="level == 'ERROR'"
                  decoration-bf="level in ('CRITICAL', 'ERROR')">
                <field name="last_seen" string="Last Seen"/>
                <field name="level" widget="badge"
                       decoration-danger="level == 'CRITICAL'"
                       decoration-warning="level == 'ERROR'"
                       decoration-info="level == 'WARNING'"/>
                <field name="module"/>
                <field name="message"/>
                <field name="count" string="×" width="60"/>
                <field name="first_seen" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_log_event_search" model="ir.ui.view">
        <field name="name">log.event.search</field>
        <field name="model">log.event</field>
        <field name="arch" type="xml">
            <search string="Search Events">
                <field name="message" string="Message"/>
                <field name="module"/>
                <filter name="filter_critical" string="Critical" domain="[('level', '=', 'CRITICAL')]"/>
                <filter name="filter_error" string="Error" domain="[('level', '=', 'ERROR')]"/>
                <filter name="filter_warning" string="Warning" domain="[('level', '=', 'WARNING')]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('last_seen', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_level" string="Level" context="{'group_by': 'level'}"/>
                    <filter name="group_module" string="Module" context="{'group_by': 'module'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- DELETE ALL server action -->
    <record id="action_log_event_delete_all" model="ir.actions.server">
        <field name="name">Delete All Events</field>
        <field name="model_id" ref="model_log_event"/>
        <field name="binding_model_id" ref="model_log_event"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
env['log.event'].search([]).unlink()
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_log_event" model="ir.actions.act_window">
        <field name="name">Error Events</field>
        <field name="res_model">log.event</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No log events yet.</p>
            <p>Click <strong>Run Now</strong> in Configuration to scan for events.</p>
        </field>
    </record>

</odoo>
