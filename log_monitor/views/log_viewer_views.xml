<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_log_viewer_form" model="ir.ui.view">
        <field name="name">log.viewer.form</field>
        <field name="model">log.viewer</field>
        <field name="arch" type="xml">
            <form string="Log File Viewer" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="log_path" readonly="1"/>
                        <field name="line_count" readonly="1" string="Lines shown"/>
                    </group>
                    <field name="content" readonly="1" nolabel="1" widget="html"
                           style="height:500px;overflow:auto;display:block;border:1px solid #dee2e6;padding:8px;background:#ffffff"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
