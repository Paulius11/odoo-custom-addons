<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Terms: every translatable UI text in the user's language -->
    <record id="view_translation_term_tree" model="ir.ui.view">
        <field name="name">translation.term.tree</field>
        <field name="model">translation.term</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" delete="0"
                  class="o_custom_translate_list"
                  decoration-info="state == 'pending'"
                  decoration-success="state == 'live'"
                  decoration-warning="not translated and not state">
                <header>
                    <button name="action_apply_pending" type="object" string="Apply drafts"
                            class="btn-primary" display="always"/>
                    <button name="action_refresh" type="object" string="Refresh term list"
                            display="always"/>
                    <button name="action_revert" type="object" string="Revert to Odoo's translation"/>
                </header>
                <field name="location" readonly="1" optional="show"/>
                <field name="source" readonly="1"/>
                <field name="value" readonly="1"/>
                <field name="new_value" placeholder="Type a new translation…"/>
                <field name="live_value" readonly="1" optional="show"/>
                <field name="state" widget="badge" readonly="1"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'live'"/>
                <field name="module" readonly="1" optional="hide"/>
                <field name="kind" readonly="1" optional="hide"/>
                <field name="translated" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_translation_term_search" model="ir.ui.view">
        <field name="name">translation.term.search</field>
        <field name="model">translation.term</field>
        <field name="arch" type="xml">
            <search string="Terms">
                <field name="source" string="Text"
                       filter_domain="['|', '|', ('source', 'ilike', self), ('value', 'ilike', self), ('live_value', 'ilike', self)]"/>
                <field name="location"/>
                <field name="module"/>
                <filter name="untranslated" string="Untranslated" domain="[('translated', '=', False)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'pending')]"/>
                <filter name="live" string="Changed (live)" domain="[('override_id.value', '!=', False)]"/>
                <separator/>
                <filter name="code" string="Code terms" domain="[('kind', '=', 'code')]"/>
                <filter name="menus" string="Menus" domain="[('res_model', '=', 'ir.ui.menu')]"/>
                <filter name="labels" string="Field labels" domain="[('res_model', '=', 'ir.model.fields')]"/>
                <filter name="selections" string="Selection values" domain="[('res_model', '=', 'ir.model.fields.selection')]"/>
                <filter name="views" string="Views" domain="[('res_model', '=', 'ir.ui.view')]"/>
                <filter name="actions" string="Actions" domain="[('res_model', '=', 'ir.actions.act_window')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_location" string="Location" context="{'group_by': 'location'}"/>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_open_terms" model="ir.actions.server">
        <field name="name">Terms</field>
        <field name="model_id" ref="model_translation_term"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_terms()</field>
    </record>

    <!-- Changes: one row per changed term, with its draft, live value and original -->
    <record id="view_translation_override_tree" model="ir.ui.view">
        <field name="name">translation.override.tree</field>
        <field name="model">translation.override</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" editable="bottom"
                  class="o_custom_translate_list"
                  decoration-info="state == 'pending'"
                  decoration-success="state == 'live'"
                  decoration-muted="state == 'original'">
                <header>
                    <button name="action_apply_pending" type="object" string="Apply drafts"
                            class="btn-primary" display="always"/>
                    <button name="action_discard_draft" type="object" string="Discard drafts"/>
                    <button name="action_revert" type="object" string="Revert to Odoo's translation"/>
                    <button name="action_revert_all" type="object" string="Revert everything"
                            display="always" class="btn-danger"
                            confirm="Every changed term goes back to Odoo's translation, and all drafts are discarded. Continue?"/>
                </header>
                <field name="location" readonly="1"/>
                <field name="source" readonly="1"/>
                <field name="original_value" readonly="1"/>
                <field name="value" readonly="1"/>
                <field name="pending_value"/>
                <field name="state" widget="badge" readonly="1"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'live'"/>
                <field name="lang" readonly="1" optional="hide"/>
                <field name="pending_uid" readonly="1" optional="hide"/>
                <field name="write_date" string="Changed" readonly="1" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_translation_override_form" model="ir.ui.view">
        <field name="name">translation.override.form</field>
        <field name="model">translation.override</field>
        <field name="arch" type="xml">
            <form string="Change" create="0" delete="0">
                <header>
                    <button name="action_revert" type="object" string="Revert to Odoo's translation"
                            invisible="not value"/>
                    <button name="action_discard_draft" type="object" string="Discard draft"
                            invisible="not pending_value"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="location"/>
                            <field name="lang"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="pending_uid" invisible="not pending_uid"/>
                            <field name="write_date" string="Changed"/>
                        </group>
                    </group>
                    <group>
                        <field name="source"/>
                        <field name="original_value"/>
                        <field name="value"/>
                        <field name="pending_value"/>
                    </group>
                    <field name="change_ids">
                        <tree>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="set_id"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_translation_override_search" model="ir.ui.view">
        <field name="name">translation.override.search</field>
        <field name="model">translation.override</field>
        <field name="arch" type="xml">
            <search string="Changes">
                <field name="source" string="Text"
                       filter_domain="['|', '|', ('source', 'ilike', self), ('value', 'ilike', self), ('pending_value', 'ilike', self)]"/>
                <field name="location"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'pending')]"/>
                <filter name="live" string="Live" domain="[('value', '!=', False)]"/>
                <filter name="original" string="Reverted" domain="[('state', '=', 'original')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_lang" string="Language" context="{'group_by': 'lang'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_translation_override" model="ir.actions.act_window">
        <field name="name">Changes</field>
        <field name="res_model">translation.override</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_draft': 1, 'search_default_live': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No changed terms yet</p>
            <p>Type a new translation in Terms, or turn on translation mode
               (the language icon in the top bar) and click any text.</p>
        </field>
    </record>

    <!-- History: every Apply and Revert, each one revertible as a whole -->
    <record id="view_translation_change_set_tree" model="ir.ui.view">
        <field name="name">translation.change.set.tree</field>
        <field name="model">translation.change.set</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" decoration-muted="reverted_by_id">
                <field name="create_date" string="When"/>
                <field name="name"/>
                <field name="operation"/>
                <field name="user_id"/>
                <field name="line_count" string="Terms"/>
                <field name="reverted_by_id" optional="show"/>
                <button name="action_revert" type="object" string="Revert" icon="fa-undo"
                        invisible="reverted_by_id"
                        confirm="Restore every term of this change set to its value before it?"/>
            </tree>
        </field>
    </record>

    <record id="view_translation_change_set_form" model="ir.ui.view">
        <field name="name">translation.change.set.form</field>
        <field name="model">translation.change.set</field>
        <field name="arch" type="xml">
            <form string="Change set" create="0" delete="0" edit="0">
                <header>
                    <button name="action_revert" type="object" string="Revert this change set"
                            invisible="reverted_by_id"
                            confirm="Restore every term of this change set to its value before it?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="operation"/>
                        </group>
                        <group>
                            <field name="create_date" string="When"/>
                            <field name="user_id"/>
                            <field name="reverted_by_id" invisible="not reverted_by_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree>
                            <field name="location"/>
                            <field name="source"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_translation_change_set" model="ir.actions.act_window">
        <field name="name">History</field>
        <field name="res_model">translation.change.set</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_translate_root" name="Translate"
              web_icon="custom_translate,static/description/icon.png"
              groups="group_translator" sequence="95"/>
    <menuitem id="menu_translate_terms" name="Terms" parent="menu_translate_root"
              action="action_open_terms" sequence="10"/>
    <menuitem id="menu_translate_changes" name="Changes" parent="menu_translate_root"
              action="action_translation_override" sequence="20"/>
    <menuitem id="menu_translate_history" name="History" parent="menu_translate_root"
              action="action_translation_change_set" sequence="30"/>
</odoo>
