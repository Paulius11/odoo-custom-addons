<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="group_translator" model="res.groups">
        <field name="name">Translator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Can change Odoo's UI translations, apply them and revert them.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_translator'))]"/>
    </record>
</odoo>
