<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_send_scheduled_reports" model="ir.cron">
        <field name="name">Scheduled Reports: send due reports</field>
        <field name="model_id" ref="model_simple_scheduled_report" />
        <field name="state">code</field>
        <field name="code">model._cron_send_due()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number" eval="15" />
        <field name="interval_type">minutes</field>
        <field name="numbercall" eval="-1" />
        <field name="active" eval="True" />
    </record>
</odoo>
