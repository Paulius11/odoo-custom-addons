<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="group_scheduled_report_manager" model="res.groups">
        <field name="name">Scheduled Reports Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <!-- A report reads records as its owner, so a manager may only own and edit their own. -->
    <record id="rule_scheduled_report_own" model="ir.rule">
        <field name="name">Scheduled reports: own reports</field>
        <field name="model_id" ref="model_simple_scheduled_report" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_scheduled_report_manager'))]" />
    </record>
    <record id="rule_scheduled_report_column_own" model="ir.rule">
        <field name="name">Scheduled report columns: own reports</field>
        <field name="model_id" ref="model_simple_scheduled_report_column" />
        <field name="domain_force">[('report_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_scheduled_report_manager'))]" />
    </record>
    <record id="rule_scheduled_report_all" model="ir.rule">
        <field name="name">Scheduled reports: all (administrators)</field>
        <field name="model_id" ref="model_simple_scheduled_report" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
    <record id="rule_scheduled_report_column_all" model="ir.rule">
        <field name="name">Scheduled report columns: all (administrators)</field>
        <field name="model_id" ref="model_simple_scheduled_report_column" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
