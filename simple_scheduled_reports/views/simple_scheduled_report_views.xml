<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="simple_scheduled_report_view_tree" model="ir.ui.view">
        <field name="name">simple.scheduled.report.tree</field>
        <field name="model">simple.scheduled.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="model_id" />
                <field name="frequency" />
                <field name="next_send" />
                <field name="last_sent" />
                <field name="user_id" widget="many2one_avatar_user" />
            </tree>
        </field>
    </record>

    <record id="simple_scheduled_report_view_form" model="ir.ui.view">
        <field name="name">simple.scheduled.report.form</field>
        <field name="model">simple.scheduled.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_send_now"
                        type="object"
                        string="Send Now"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Overdue invoices" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}" />
                            <field name="model_name" invisible="1" />
                            <field name="user_id" widget="many2one_avatar_user" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="next_send" />
                            <field name="last_sent" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Records" name="records">
                            <group>
                                <field
                                    name="domain"
                                    widget="domain"
                                    options="{'model': 'model_name', 'in_dialog': True}"
                                    invisible="not model_id"
                                />
                                <field
                                    name="date_field_id"
                                    options="{'no_create': True, 'no_open': True}"
                                    invisible="not model_id"
                                />
                                <label for="period" invisible="not date_field_id" />
                                <div class="o_row" invisible="not date_field_id">
                                    <field name="period" />
                                    <field name="period_count" invisible="period == 'this'" />
                                    <field name="period_unit" />
                                </div>
                                <field
                                    name="groupby_field_id"
                                    options="{'no_create': True, 'no_open': True}"
                                    invisible="not model_id"
                                />
                            </group>
                            <field name="column_ids" invisible="not model_id">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="field_id"
                                        options="{'no_create': True, 'no_open': True}"
                                    />
                                </tree>
                            </field>
                        </page>
                        <page string="Schedule" name="schedule">
                            <group>
                                <field name="frequency" widget="radio" />
                                <label for="mon" string="Weekdays" invisible="frequency != 'weekly'" />
                                <div class="o_row" invisible="frequency != 'weekly'">
                                    <field name="mon" /><label for="mon" string="Mon" />
                                    <field name="tue" /><label for="tue" string="Tue" />
                                    <field name="wed" /><label for="wed" string="Wed" />
                                    <field name="thu" /><label for="thu" string="Thu" />
                                    <field name="fri" /><label for="fri" string="Fri" />
                                    <field name="sat" /><label for="sat" string="Sat" />
                                    <field name="sun" /><label for="sun" string="Sun" />
                                </div>
                                <field name="month_day" invisible="frequency != 'monthly'" />
                                <field name="send_hour" widget="float_time" />
                            </group>
                        </page>
                        <page string="Recipients" name="recipients">
                            <group>
                                <field name="recipient_user_ids" widget="many2many_tags_avatar" />
                                <field name="recipient_partner_ids" widget="many2many_tags" />
                                <field name="email_to" placeholder="a@example.com, b@example.com" />
                                <field name="attach_xlsx" />
                                <field name="skip_empty" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="simple_scheduled_report_view_search" model="ir.ui.view">
        <field name="name">simple.scheduled.report.search</field>
        <field name="model">simple.scheduled.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="model_id" />
                <field name="user_id" />
                <filter name="mine" string="My Reports" domain="[('user_id', '=', uid)]" />
                <separator />
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}" />
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="simple_scheduled_report_action" model="ir.actions.act_window">
        <field name="name">Scheduled Reports</field>
        <field name="res_model">simple.scheduled.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Mail a list on a schedule</p>
            <p>
                Pick a model, a filter and columns. Odoo mails the matching records as a
                table and an Excel file, daily, weekly or monthly.
            </p>
        </field>
    </record>

    <menuitem
        id="simple_scheduled_report_menu"
        name="Scheduled Reports"
        parent="mail.menu_root_discuss"
        action="simple_scheduled_report_action"
        groups="group_scheduled_report_manager"
        sequence="60"
    />
</odoo>
