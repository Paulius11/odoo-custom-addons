<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit search view to add "Updates Available" filter -->
    <record id="view_module_filter_inherit_version_badge" model="ir.ui.view">
        <field name="name">ir.module.module.filter.inherit.version.badge</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.view_module_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='not_installed']" position="after">
                <separator/>
                <filter name="updates_available" string="Updates Available"
                        domain="[('state', '=', 'installed'), ('has_version_upgrade', '=', True)]"/>
                <filter name="recently_operated" string="Recently Installed/Upgraded"
                        domain="[('last_operation_date', '!=', False)]"/>
                <filter name="newly_added" string="Newly Added"
                        domain="[('is_newly_added', '=', True)]"/>
                <filter name="recently_upgraded" string="Recently Upgraded"
                        domain="[('is_recently_upgraded', '=', True)]"/>
            </xpath>
            <xpath expr="//group[@expand='0']" position="inside">
                <filter string="Last Installed/Upgraded" name="group_last_operation"
                        context="{'group_by': 'last_operation_date:month'}"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit ir.module.module kanban view to add version badges -->
    <record id="module_view_kanban_inherit_version_badge" model="ir.ui.view">
        <field name="name">ir.module.module.kanban.inherit.version.badge</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_view_kanban"/>
        <field name="arch" type="xml">

            <!-- Add computed fields to kanban field list -->
            <xpath expr="//kanban/field[@name='application']" position="after">
                <field name="installed_version"/>
                <field name="latest_version"/>
                <field name="version_badge_text"/>
                <field name="version_badge_class"/>
                <field name="has_version_upgrade"/>
                <field name="is_newly_added"/>
                <field name="is_recently_upgraded"/>
            </xpath>

            <!-- Make title a flex row so version sits top-right without clipping -->
            <xpath expr="//h4[hasclass('o_kanban_record_title')]" position="attributes">
                <attribute name="class">o_kanban_record_title oe_module_title_flex</attribute>
            </xpath>

            <!-- Inject version as flex child after title text -->
            <xpath expr="//h4[hasclass('o_kanban_record_title')]/field[@name='shortdesc']" position="after">
                <t t-if="record.state.raw_value == 'installed'" groups="base.group_system">
                    <span t-attf-class="oe_version_sup {{record.has_version_upgrade.raw_value and 'version-upgrade' or ''}}"
                          t-att-title="record.version_badge_text.value">
                        <t t-out="record.version_badge_text.value"/>
                    </span>
                </t>
            </xpath>

            <!-- NEW/UPGRADED/UPDATE badges in action bar (sits inline with Module Info / Learn More) -->
            <xpath expr="//div[hasclass('oe_module_action')]" position="inside">
                <t t-if="record.state.raw_value == 'installed'" groups="base.group_system">
                    <t t-if="record.has_version_upgrade.raw_value">
                        <span class="mv_badge mv_badge_update">NEW VERSION</span>
                    </t>
                    <t t-if="record.is_newly_added.raw_value">
                        <span class="mv_badge mv_badge_new">ADDED</span>
                    </t>
                    <t t-if="record.is_recently_upgraded.raw_value">
                        <span class="mv_badge mv_badge_upgraded">UPGRADED</span>
                    </t>
                </t>
            </xpath>

        </field>
    </record>

    <!-- Add last_operation_date column to list view, sorted newest first -->
    <record id="view_module_tree_check_updates" model="ir.ui.view">
        <field name="name">ir.module.module.tree.check.updates</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">last_operation_date desc</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="last_operation_date" string="Last Installed/Upgraded" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Server action + menu item: Check Updates in Apps top navbar -->
    <record id="action_server_check_updates" model="ir.actions.server">
        <field name="name">Check App Store Updates</field>
        <field name="model_id" ref="base.model_ir_module_module"/>
        <field name="state">code</field>
        <field name="code">action = env['ir.module.module'].action_check_updates_ui()</field>
    </record>

    <menuitem
        id="menu_check_app_store_updates"
        name="Check App Store Updates"
        parent="base.menu_apps"
        action="action_server_check_updates"
        sequence="25"
        groups="base.group_system"/>

    <!-- Add Module Path field after Technical Name in form view -->
    <record id="view_module_form_add_path" model="ir.ui.view">
        <field name="name">ir.module.module.form.add.path</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='information']//field[@name='name']" position="after">
                <field name="module_path"/>
            </xpath>
            <xpath expr="//page[@name='information']//field[@name='installed_version']" position="after">
                <field name="latest_version" readonly="1"/>
            </xpath>
        </field>
    </record>


    <!-- Add Upgrade History notebook tab to module form view -->
    <record id="view_module_form_upgrade_history" model="ir.ui.view">
        <field name="name">ir.module.module.form.upgrade.history</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="History" groups="base.group_system">
                    <field name="upgrade_history_ids">
                        <tree create="false">
                            <field name="upgrade_date"/>
                            <field name="operation_type"/>
                            <field name="from_version"/>
                            <field name="to_version"/>
                            <field name="user_id"/>
                            <field name="status" decoration-success="status=='success'"
                                   decoration-danger="status=='failed'"
                                   decoration-warning="status=='pending'"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
