<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.module.version</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Module Version" name="module_version">
                    <block title="App Store Update Checker" name="module_version_settings">
                        <setting
                            help="Check for newer module versions available in the Odoo App Store"
                            string="Module Version Checker"
                        >
                            <div class="mt8">
                                <button
                                    type="object"
                                    name="action_check_updates_ui"
                                    string="Check for Updates"
                                    icon="fa-refresh"
                                    class="btn-primary"
                                />
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
